---
import { nav, site } from '../data/site'
const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const actif = (href: string) => path === href || path.startsWith(href + '/')
---

<header class="nav">
  <div class="wrap nav__inner">
    <a href="/" class="nav__logo" aria-label={`${site.nom} — accueil`}>
      <img src="/img/brand/logo.webp" alt="" width="44" height="44" />
      <span class="nav__mot">MiruMiru</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav__check" />
    <label for="nav-toggle" class="nav__burger" aria-hidden="true">
      <span></span><span></span><span></span>
    </label>

    <nav class="nav__menu" aria-label="Navigation principale">
      {nav.map((l) => (
        <a href={l.href} class:list={['nav__lien', { 'is-actif': actif(l.href) }]}>{l.label}</a>
      ))}
      <a href="/contact" class="btn btn--primary nav__cta">Nous contacter</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--cream) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .nav__inner { display: flex; align-items: center; gap: 1rem; min-height: 72px; }

  .nav__logo {
    display: flex; align-items: center; gap: .6rem;
    text-decoration: none; margin-right: auto;
  }
  .nav__logo img { width: 44px; height: 44px; object-fit: contain; }
  .nav__mot {
    font-family: var(--font-display); font-weight: 600;
    font-size: 1.42rem; letter-spacing: -0.02em; color: var(--ink);
  }

  .nav__menu { display: flex; align-items: center; gap: 1.65rem; }
  .nav__lien {
    font-size: .96rem; font-weight: 500; text-decoration: none;
    color: var(--ink-2); position: relative; padding: .25rem 0;
    transition: color .18s ease;
  }
  .nav__lien:hover { color: var(--ink); }
  .nav__lien::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -2px; height: 2px;
    background: var(--rose); border-radius: 2px;
    transform: scaleX(0); transform-origin: left; transition: transform .2s ease;
  }
  .nav__lien:hover::after, .nav__lien.is-actif::after { transform: scaleX(1); }
  .nav__lien.is-actif { color: var(--ink); }
  .nav__cta { padding: .6rem 1.25rem; font-size: .95rem; box-shadow: 0 4px 0 var(--rose-deep); }

  .nav__check, .nav__burger { display: none; }

  @media (max-width: 900px) {
    .nav__burger {
      display: flex; flex-direction: column; justify-content: center; gap: 5px;
      width: 44px; height: 44px; cursor: pointer; padding: 0 8px;
    }
    .nav__burger span { display: block; height: 2px; background: var(--ink); border-radius: 2px; transition: transform .2s ease, opacity .2s ease; }
    .nav__menu {
      position: absolute; inset: 72px 0 auto 0;
      flex-direction: column; align-items: stretch; gap: 0;
      background: var(--cream); border-bottom: 1px solid var(--line);
      padding: .5rem 1.25rem 1.5rem;
      max-height: 0; overflow: hidden; opacity: 0;
      transition: max-height .28s ease, opacity .2s ease;
    }
    .nav__check:checked ~ .nav__menu { max-height: 70vh; opacity: 1; overflow: auto; }
    .nav__check:checked ~ .nav__burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav__check:checked ~ .nav__burger span:nth-child(2) { opacity: 0; }
    .nav__check:checked ~ .nav__burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
    .nav__lien { padding: .85rem 0; border-bottom: 1px solid var(--line); font-size: 1.05rem; }
    .nav__lien::after { display: none; }
    .nav__cta { margin-top: 1.1rem; justify-content: center; }
  }
</style>
