---
import Base from '../layouts/Base.astro'
---

<Base title="Page introuvable" description="Cette page n’existe pas ou plus sur mirumiru-pro.com." noindex>
  <section class="perdu">
    <div class="wrap-narrow">
      <p class="code" aria-hidden="true">404</p>
      <h1>La perle a roulé sous le comptoir</h1>
      <p class="lead">
        Cette page n’existe pas, ou plus. Notre boutique en ligne a laissé place
        au site de la marque. Les pages produits d’avant ont été regroupées.
      </p>
      <div class="actions">
        <a href="/" class="btn btn--primary">Retour à l’accueil</a>
        <a href="/perles-de-fruits" class="btn btn--ghost">Voir les parfums</a>
        <a href="/blog" class="btn btn--ghost">Le journal</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .perdu { padding: clamp(4rem, 12vw, 8rem) 0; text-align: center; }
  .code { font-family: var(--font-display); font-weight: 600; font-size: clamp(4rem, 16vw, 9rem); line-height: 1; color: color-mix(in srgb, var(--rose) 30%, transparent); margin: 0 0 .5rem; }
  .perdu .lead { margin-inline: auto; }
  .actions { display: flex; flex-wrap: wrap; gap: .9rem; justify-content: center; margin-top: 2.2rem; }
</style>
