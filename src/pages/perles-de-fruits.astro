---
import Base from '../layouts/Base.astro'
import EnteteePage from '../components/EnteteePage.astro'
import ParfumCarte from '../components/ParfumCarte.astro'
import { parfums } from '../data/produits'
---

<Base
  title="Perles de fruits pour bubble tea : tous les parfums MiruMiru"
  description="Popping boba MiruMiru : fraise, mangue, litchi, passion, pomme verte, pêche, framboise, cerise, myrtille, grenade. Seau pro de 3,1 kg, disponible chez Metro."
  image="/img/produits/perles-fraise.webp"
>
  <EnteteePage
    eyebrow="La gamme"
    titre="Découvrez nos parfums de perles de fruits"
    intro="Une fine membrane végétale, un cœur liquide aux saveurs fruitées qui éclate en bouche. Découvrez chaque parfum, sa couleur et les accords qui fonctionnent le mieux en boutique."
  />

  <section class="section">
    <div class="wrap">
      <div class="grid grid--parfums">
        {parfums.map((p) => <ParfumCarte parfum={p} detaille />)}
        <a href="/contact" class="tuile-cta reveal">
          <span class="tuile-cta__pastilles" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span class="tuile-cta__titre">Un parfum qui n’est pas là&nbsp;?</span>
          <span class="tuile-cta__plus">Parlez-nous de votre carte →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap fiche">
      <div class="reveal">
        <p class="eyebrow">Fiche produit</p>
        <h2>Ce qu’il y a dans le seau</h2>
        <p class="lead">
          Un conditionnement unique pour toute la gamme : le seau professionnel
          de 3,1 kg, conditionné par carton de quatre.
        </p>
      </div>

      <dl class="specs reveal">
        <div><dt>Poids net</dt><dd>3,1 kg par seau</dd></div>
        <div><dt>Net égoutté</dt><dd>2,2 kg</dd></div>
        <div><dt>Carton</dt><dd>4 seaux</dd></div>
        <div><dt>Avant ouverture</dt><dd>0 à 35 °C, à l’abri de la lumière</dd></div>
        <div><dt>Après ouverture</dt><dd>1 mois au frais</dd></div>
        <div><dt>Allergènes</dt><dd>Sans gluten</dd></div>
      </dl>
    </div>
  </section>

  <section class="section section--cream2">
    <div class="wrap-narrow">
      <p class="eyebrow">Composition</p>
      <h2>Ce que contient une perle</h2>
      <div class="texte-long">
        <p>
          Chaque parfum a sa propre liste d’ingrédients, reprise de la fiche
          fabricant sur sa fiche produit. Toutes partagent une base d’eau et de
          fructose, une membrane gélifiée à l’alginate de sodium et au lactate de
          calcium, et l’arôme du parfum ; selon le parfum, des colorants
          apportent la teinte.
        </p>
        <ul class="liens-parfums">
          {parfums.map((p) => <li><a href={`/perles-de-fruits/${p.slug}`}>{p.nom}</a></li>)}
        </ul>
        <p class="note">
          Les fiches techniques et les étiquetages complets font foi et sont
          disponibles sur demande : écrivez-nous, on vous les envoie.
        </p>
      </div>
      <div class="centre">
        <a href="/contact" class="btn btn--primary">Demander les fiches techniques</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .fiche { display: grid; grid-template-columns: 1fr 1.15fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  @media (max-width: 880px) { .fiche { grid-template-columns: 1fr; } }

  .specs { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 1px; margin: 0; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .specs > div { background: var(--paper); padding: 1.3rem 1.4rem; }
  .specs dt { font-family: var(--font-display); font-weight: 600; font-size: .74rem; letter-spacing: .12em; text-transform: uppercase; color: var(--rose-deep); margin-bottom: .35rem; }
  .specs dd { margin: 0; font-size: 1.02rem; color: var(--ink); }

  .texte-long { font-size: 1.03rem; color: var(--ink-2); }
  .liens-parfums { list-style: none; padding: 0; margin: 1.2rem 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .liens-parfums a { display: inline-block; padding: .35rem .85rem; border: 1px solid var(--line); border-radius: 999px; background: var(--paper); color: var(--ink); text-decoration: none; font-size: .95rem; }
  .liens-parfums a:hover { border-color: var(--rose); color: var(--rose-deep); }

  .tuile-cta {
    display: flex; flex-direction: column; justify-content: center;
    background: var(--ink); color: var(--cream); text-decoration: none;
    border-radius: var(--radius-lg); padding: 1.8rem 1.6rem; min-height: 220px;
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .tuile-cta:hover { transform: translateY(-6px); box-shadow: var(--shadow-lift); color: var(--cream); }
  .tuile-cta__pastilles { display: flex; gap: .45rem; margin-bottom: 1.1rem; }
  .tuile-cta__pastilles i { width: 13px; height: 13px; border-radius: 50%; }
  .tuile-cta__pastilles i:nth-child(1) { background: var(--peche); }
  .tuile-cta__pastilles i:nth-child(2) { background: var(--passion); }
  .tuile-cta__pastilles i:nth-child(3) { background: var(--framboise); }
  .tuile-cta__pastilles i:nth-child(4) { background: var(--mint); }
  .tuile-cta__titre { font-family: var(--font-display); font-weight: 600; font-size: 1.3rem; line-height: 1.2; margin-bottom: .6rem; }
  .tuile-cta__plus { font-size: .88rem; color: var(--mango); }
  .note { font-size: .93rem; color: var(--ink-3); border-left: 3px solid var(--line); padding-left: 1rem; }
  .centre { display: flex; justify-content: center; margin-top: 2.5rem; }
</style>
