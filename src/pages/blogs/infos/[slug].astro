---
import { getCollection, render } from 'astro:content'
import Base from '../../../layouts/Base.astro'
import ArticleCarte from '../../../components/ArticleCarte.astro'
import { site } from '../../../data/site'
import { metaDescription } from '../../../lib/seo'

export async function getStaticPaths() {
  const articles = await getCollection('blog')
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }))
}

const { article } = Astro.props
const { Content } = await render(article)

const tous = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)
const suggestions = tous.filter((a) => a.id !== article.id).slice(0, 3)

const dateISO = article.data.pubDate.toISOString()
const dateFr = article.data.pubDate.toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})

const description = metaDescription(article.data.description)

const url = `${site.url}/blogs/infos/${article.id}`
const redaction = /mirumiru/i.test(article.data.author)
const { resume, faq = [], sources = [], coverAlt, updated } = article.data

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.data.title,
  description,
  inLanguage: 'fr-FR',
  datePublished: dateISO,
  dateModified: (updated ?? article.data.pubDate).toISOString(),
  author: redaction
    ? { '@type': 'Organization', name: 'MiruMiru', url: site.url }
    : { '@type': 'Person', name: article.data.author },
  publisher: {
    '@type': 'Organization',
    name: 'MiruMiru',
    logo: { '@type': 'ImageObject', url: `${site.url}/img/brand/icone-512.png` },
  },
  mainEntityOfPage: url,
  ...(resume ? { abstract: resume } : {}),
  ...(sources.length ? { citation: sources.map((s) => s.url) } : {}),
  ...(article.data.cover ? { image: `${site.url}${article.data.cover}` } : {}),
}

const fil = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site.url}/blog` },
    { '@type': 'ListItem', position: 3, name: article.data.title, item: url },
  ],
}

const faqSchema = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((x) => ({
        '@type': 'Question',
        name: x.q,
        acceptedAnswer: { '@type': 'Answer', text: x.r },
      })),
    }
  : null
---

<Base
  title={article.data.title}
  description={description}
  image={article.data.cover}
  type="article"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(fil)} />
  {faqSchema && <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />}

  <article>
    <header class="tete-art">
      <div class="wrap-narrow">
        <a href="/blog" class="retour">← Le journal</a>
        <h1>{article.data.title}</h1>
        <p class="meta">
          <time datetime={dateISO}>{dateFr}</time>
          <span aria-hidden="true">·</span>
          <span>{article.data.author}</span>
        </p>
      </div>
    </header>

    {article.data.cover && (
      <div class="wrap couverture">
        <img src={article.data.cover} alt={coverAlt ?? ''} width="1200" height="700" fetchpriority="high" />
      </div>
    )}

    <div class="wrap-narrow corps">
      {resume && (
        <aside class="en-bref" aria-label="En bref">
          <p class="en-bref__titre">En bref</p>
          <p>{resume}</p>
        </aside>
      )}
      <div class="prose">
        <Content />
      </div>

      {faq.length > 0 && (
        <section class="faq-art" aria-labelledby="faq-titre">
          <h2 id="faq-titre">Questions fréquentes</h2>
          {faq.map((x) => (
            <details>
              <summary>{x.q}</summary>
              <p>{x.r}</p>
            </details>
          ))}
        </section>
      )}

      {sources.length > 0 && (
        <section class="sources" aria-labelledby="sources-titre">
          <h2 id="sources-titre">Sources</h2>
          <ol>
            {sources.map((s) => (
              <li><a href={s.url} rel="noopener nofollow" target="_blank">{s.titre}</a></li>
            ))}
          </ol>
        </section>
      )}
    </div>
  </article>

  <section class="section section--cream2">
    <div class="wrap">
      <h2 class="titre-suite">À lire aussi</h2>
      <div class="grid grid--3">
        {suggestions.map((a) => (
          <ArticleCarte
            href={`/blogs/infos/${a.id}`}
            titre={a.data.title}
            description={a.data.description}
            date={a.data.pubDate.toISOString().slice(0, 10)}
            image={a.data.cover}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="wrap-narrow bandeau-cta">
      <p class="eyebrow">MiruMiru</p>
      <h2>Des perles de fruits pour votre carte</h2>
      <p class="lead">
        Des parfums de popping boba fruités et colorés, par une marque
        française. Disponibles pour les professionnels chez Metro.
      </p>
      <div class="actions">
        <a href="/perles-de-fruits" class="btn btn--primary">Voir la gamme</a>
        <a href="/contact" class="btn btn--ghost">Nous écrire</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .tete-art { padding: clamp(2.5rem, 5vw, 4rem) 0 1.8rem; }
  .retour { font-family: var(--font-display); font-weight: 600; font-size: .9rem; color: var(--rose-deep); text-decoration: none; display: inline-block; margin-bottom: 1.4rem; }
  .retour:hover { text-decoration: underline; }
  .tete-art h1 { font-size: clamp(2rem, 4.6vw, 3.2rem); }
  .meta { display: flex; gap: .6rem; align-items: center; font-size: .9rem; color: var(--ink-3); margin: 0; }

  .couverture { margin-bottom: clamp(2rem, 4vw, 3rem); }
  .couverture img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius-lg); box-shadow: var(--shadow); }

  .corps { padding-bottom: clamp(3rem, 6vw, 5rem); }

  .en-bref { background: var(--cream-2); border-left: 4px solid var(--rose); border-radius: 0 var(--radius) var(--radius) 0; padding: 1.1rem 1.4rem; margin-bottom: 2.2rem; font-size: 1.04rem; color: var(--ink); }
  .en-bref p { margin: 0; }
  .en-bref__titre { font-family: var(--font-display); font-weight: 600; font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; color: var(--rose-deep); margin-bottom: .35rem !important; }

  .faq-art, .sources { margin-top: 3rem; }
  .faq-art h2, .sources h2 { font-size: clamp(1.4rem, 2.4vw, 1.8rem); margin-bottom: 1rem; }
  .faq-art details { border-top: 1px solid var(--line); padding: .9rem 0; }
  .faq-art details:last-child { border-bottom: 1px solid var(--line); }
  .faq-art summary { cursor: pointer; font-family: var(--font-display); font-weight: 600; color: var(--ink); }
  .faq-art details p { margin: .6rem 0 0; color: var(--ink-2); }
  .sources ol { padding-left: 1.3em; font-size: .92rem; color: var(--ink-3); }
  .sources li { margin-bottom: .35rem; word-break: break-word; }
  .sources a { color: var(--ink-2); }

  .titre-suite { text-align: center; margin-bottom: 2.4rem; }

  .bandeau-cta { text-align: center; }
  .bandeau-cta .lead { margin-inline: auto; }
  .actions { display: flex; flex-wrap: wrap; gap: .9rem; justify-content: center; margin-top: 2rem; }
</style>
