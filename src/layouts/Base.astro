---
import '../styles/global.css'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import { site } from '../data/site'

interface Props {
  title: string
  description: string
  image?: string
  type?: 'website' | 'article'
  noindex?: boolean
}

const { title, description, image = '/img/brand/og.jpg', type = 'website', noindex = false } = Astro.props
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site ?? site.url).href
const ogImage = new URL(image, Astro.site ?? site.url).href
// Suffixe de marque seulement s'il tient dans ~60 caractères (troncature Google).
const titreComplet =
  title.includes(site.nom) || title.length + site.nom.length + 3 > 62 ? title : `${title} · ${site.nom}`
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    <script is:inline>
      // L'URL de travail *.pages.dev ne doit jamais être indexée : seul
      // mirumiru-pro.com est le domaine de référence (évite le contenu dupliqué).
      if (location.hostname.endsWith('.pages.dev')) {
        var m = document.createElement('meta')
        m.name = 'robots'; m.content = 'noindex, nofollow'
        document.head.appendChild(m)
      }
    </script>

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preload" href="/fonts/fredoka-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:site_name" content={site.nom} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image:alt" content={titreComplet} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#FFFBF4" />

    <link rel="alternate" type="application/rss+xml" title={`Blog ${site.nom}`} href="/rss.xml" />
    <slot name="head" />
  </head>
  <body>
    <a href="#contenu" class="sr-only">Aller au contenu</a>
    <Nav />
    <main id="contenu">
      <slot />
    </main>
    <Footer />

    <script>
      const cibles = document.querySelectorAll('.reveal')
      if (cibles.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in')
                io.unobserve(e.target)
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        )
        cibles.forEach((c) => io.observe(c))
      }
    </script>
  </body>
</html>
